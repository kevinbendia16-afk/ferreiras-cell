<%- include('../partials/header', { pageTitle: 'Venda #' + venda.id }) %>
<div class="page-header">
  <h4><i class="bi bi-receipt-cutoff"></i> Venda #<%= venda.id %></h4>
  <a href="/vendas" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Voltar</a>
</div>

<div class="row g-3">
  <div class="col-md-8">
    <div class="card">
      <div class="card-header">Itens da Venda</div>
      <div class="table-responsive">
        <table class="table mb-0">
          <thead><tr><th>Produto</th><th>Qtd</th><th>Preço Unit.</th><th>Subtotal</th></tr></thead>
          <tbody>
            <% itens.forEach(i => { %>
            <tr>
              <td><%= i.produto_nome %></td>
              <td><%= i.quantidade %></td>
              <td>R$ <%= Number(i.preco_unitario).toFixed(2) %></td>
              <td class="fw-bold">R$ <%= Number(i.subtotal).toFixed(2) %></td>
            </tr>
            <% }) %>
          </tbody>
          <tfoot>
            <tr>
              <td colspan="3" class="text-end fw-bold">Total:</td>
              <td class="fw-bold text-success fs-5">R$ <%= Number(venda.valor_total).toFixed(2) %></td>
            </tr>
          </tfoot>
        </table>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card">
      <div class="card-header">Informações</div>
      <div class="card-body">
        <p><strong>Data:</strong><br><%= new Date(venda.criado_em).toLocaleDateString('pt-BR') %> às <%= new Date(venda.criado_em).toLocaleTimeString('pt-BR', {hour:'2-digit',minute:'2-digit'}) %></p>
        <p><strong>Cliente:</strong><br><%= venda.cliente_nome || 'Consumidor final' %></p>
        <p><strong>Vendedor:</strong><br><%= venda.vendedor_nome || '-' %></p>
        <p><strong>Forma de Pagamento:</strong><br><span class="badge bg-success"><%= venda.forma_pagamento %></span></p>
        <% if (venda.observacoes) { %><p><strong>Obs:</strong><br><%= venda.observacoes %></p><% } %>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
