<%- include('../partials/header', { pageTitle: 'Vendas' }) %>
<div class="page-header">
  <h4><i class="bi bi-receipt-cutoff"></i> Histórico de Vendas</h4>
  <a href="/pdv" class="btn btn-success btn-sm"><i class="bi bi-cart-plus"></i> Nova Venda (PDV)</a>
</div>

<div class="card">
  <div class="table-responsive">
    <table class="table table-hover mb-0">
      <thead>
        <tr>
          <th>#</th>
          <th>Data</th>
          <th>Cliente</th>
          <th>Itens</th>
          <th>Pagamento</th>
          <th>Vendedor</th>
          <th>Total</th>
        </tr>
      </thead>
      <tbody>
        <% vendas.forEach(v => { %>
        <tr onclick="location.href='/vendas/<%= v.id %>'" style="cursor:pointer">
          <td><span class="text-success fw-bold">#<%= v.id %></span></td>
          <td class="text-muted"><%= new Date(v.criado_em).toLocaleDateString('pt-BR') %> <%= new Date(v.criado_em).toLocaleTimeString('pt-BR', {hour:'2-digit',minute:'2-digit'}) %></td>
          <td><%= v.cliente_nome || 'Consumidor' %></td>
          <td class="text-muted" style="max-width:300px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis"><%= v.itens_desc || '-' %></td>
          <td><span class="badge bg-<%= v.forma_pagamento==='Pix'?'success':v.forma_pagamento==='Dinheiro'?'warning':'info' %>"><%= v.forma_pagamento %></span></td>
          <td><%= v.vendedor_nome || '-' %></td>
          <td class="fw-bold">R$ <%= Number(v.valor_total).toFixed(2) %></td>
        </tr>
        <% }) %>
        <% if (!vendas.length) { %>
        <tr><td colspan="7" class="text-center text-muted py-4">Nenhuma venda registrada</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../partials/footer') %>
