<%- include('../partials/header', { pageTitle: conta ? 'Editar Conta' : 'Nova Conta' }) %>
<h4><i class="bi bi-receipt"></i> <%= conta && conta.id ? 'Editar' : 'Nova' %> Conta</h4>
<% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
<form method="POST" action="/financeiro/contas<%= conta && conta.id ? '/'+conta.id : '' %>">
  <div class="row g-3">
    <div class="col-md-3">
      <label class="form-label">Tipo *</label>
      <select name="tipo" class="form-select" required>
        <option value="pagar" <%= conta && conta.tipo==='pagar'?'selected':'' %>>A Pagar</option>
        <option value="receber" <%= conta && conta.tipo==='receber'?'selected':'' %>>A Receber</option>
      </select>
    </div>
    <div class="col-md-5"><label class="form-label">Descrição *</label><input type="text" name="descricao" class="form-control" value="<%= conta ? conta.descricao : '' %>" required></div>
    <div class="col-md-2"><label class="form-label">Valor *</label><input type="number" name="valor" class="form-control" step="0.01" value="<%= conta ? conta.valor : '' %>" required></div>
    <div class="col-md-2"><label class="form-label">Vencimento</label><input type="date" name="data_vencimento" class="form-control" value="<%= conta && conta.data_vencimento ? new Date(conta.data_vencimento).toISOString().slice(0,10) : '' %>"></div>
    <div class="col-md-3">
      <label class="form-label">Categoria</label>
      <select name="categoria" class="form-select" id="categoriaSelect">
        <option value="">Selecione...</option>
        <optgroup label="A Pagar" class="cat-pagar">
          <option value="Aluguel" <%= conta && conta.categoria==='Aluguel'?'selected':'' %>>Aluguel</option>
          <option value="Energia" <%= conta && conta.categoria==='Energia'?'selected':'' %>>Energia</option>
          <option value="Água" <%= conta && conta.categoria==='Água'?'selected':'' %>>Água</option>
          <option value="Internet" <%= conta && conta.categoria==='Internet'?'selected':'' %>>Internet</option>
          <option value="Telefone" <%= conta && conta.categoria==='Telefone'?'selected':'' %>>Telefone</option>
          <option value="Fornecedor" <%= conta && conta.categoria==='Fornecedor'?'selected':'' %>>Fornecedor</option>
          <option value="Manutenção" <%= conta && conta.categoria==='Manutenção'?'selected':'' %>>Manutenção</option>
          <option value="Impostos" <%= conta && conta.categoria==='Impostos'?'selected':'' %>>Impostos</option>
          <option value="Salários" <%= conta && conta.categoria==='Salários'?'selected':'' %>>Salários</option>
        </optgroup>
        <optgroup label="A Receber" class="cat-receber">
          <option value="Ordem de Serviço" <%= conta && conta.categoria==='Ordem de Serviço'?'selected':'' %>>Ordem de Serviço</option>
          <option value="Venda Balcão" <%= conta && conta.categoria==='Venda Balcão'?'selected':'' %>>Venda Balcão</option>
        </optgroup>
        <option value="Outros" <%= conta && conta.categoria==='Outros'?'selected':'' %>>Outros</option>
      </select>
    </div>
    <% if (conta && conta.id) { %>
    <div class="col-md-3">
      <label class="form-label">Status</label>
      <select name="status" class="form-select">
        <% ['pendente','pago','atrasado','cancelado'].forEach(s => { %>
        <option value="<%= s %>" <%= conta.status===s?'selected':'' %>><%= s %></option>
        <% }) %>
      </select>
    </div>
    <div class="col-md-3"><label class="form-label">Data Pagamento</label><input type="date" name="data_pagamento" class="form-control" value="<%= conta && conta.data_pagamento ? new Date(conta.data_pagamento).toISOString().slice(0,10) : '' %>"></div>
    <% } %>
    <div class="col-12"><label class="form-label">Observações</label><textarea name="observacoes" class="form-control" rows="2"><%= conta ? conta.observacoes||'' : '' %></textarea></div>
  </div>
  <div class="mt-3">
    <button class="btn btn-success"><i class="bi bi-check"></i> Salvar</button>
    <a href="/financeiro/contas" class="btn btn-secondary">Cancelar</a>
  </div>
</form>
<%- include('../partials/footer') %>
