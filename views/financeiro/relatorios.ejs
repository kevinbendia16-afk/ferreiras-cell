<%- include('../partials/header', { pageTitle: 'Relatórios' }) %>
<div class="page-header">
  <h4><i class="bi bi-file-earmark-bar-graph"></i> Relatórios Financeiros</h4>
</div>

<form class="row g-2 mb-4">
  <div class="col-md-3"><label class="form-label">De</label><input type="date" name="de" class="form-control" value="<%= de %>"></div>
  <div class="col-md-3"><label class="form-label">Até</label><input type="date" name="ate" class="form-control" value="<%= ate %>"></div>
  <div class="col-auto d-flex align-items-end"><button class="btn btn-success"><i class="bi bi-search"></i> Gerar</button></div>
</form>

<div class="row g-3 mb-4">
  <div class="col-md-4">
    <div class="stat-card green">
      <i class="bi bi-arrow-up-circle stat-icon"></i>
      <div class="stat-value">R$ <%= receitas.toFixed(2) %></div>
      <div class="stat-label">Total Receitas</div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="stat-card red">
      <i class="bi bi-arrow-down-circle stat-icon"></i>
      <div class="stat-value">R$ <%= despesas.toFixed(2) %></div>
      <div class="stat-label">Total Despesas</div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="stat-card <%= lucro >= 0 ? 'green' : 'red' %>">
      <i class="bi bi-trophy stat-icon"></i>
      <div class="stat-value">R$ <%= lucro.toFixed(2) %></div>
      <div class="stat-label">Resultado</div>
    </div>
  </div>
</div>

<div class="row g-3">
  <div class="col-md-4">
    <div class="card">
      <div class="card-header"><i class="bi bi-tools text-success"></i> Ordens de Serviço</div>
      <div class="card-body text-center">
        <h3 class="text-success"><%= os.qtd %></h3>
        <small class="text-muted">Entregues no período</small>
        <hr>
        <h5>R$ <%= Number(os.total).toFixed(2) %></h5>
        <small class="text-muted">Faturamento OS</small>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card">
      <div class="card-header"><i class="bi bi-cart3 text-success"></i> Vendas Balcão (PDV)</div>
      <div class="card-body text-center">
        <h3 class="text-success"><%= vendas.qtd %></h3>
        <small class="text-muted">Vendas no período</small>
        <hr>
        <h5>R$ <%= Number(vendas.total).toFixed(2) %></h5>
        <small class="text-muted">Faturamento PDV</small>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card">
      <div class="card-header"><i class="bi bi-bag text-success"></i> Compras</div>
      <div class="card-body text-center">
        <h3 class="text-danger"><%= compras.qtd %></h3>
        <small class="text-muted">Compras pagas</small>
        <hr>
        <h5>R$ <%= Number(compras.total).toFixed(2) %></h5>
        <small class="text-muted">Gasto com fornecedores</small>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
