<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <script>document.documentElement.setAttribute('data-theme', localStorage.getItem('theme') || 'dark');</script>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Ferreira's Cell - <%= typeof pageTitle !== 'undefined' ? pageTitle : 'Sistema' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>
<% if (user) { %>
<nav class="navbar navbar-expand-lg navbar-dark">
  <div class="container-fluid">
    <a class="navbar-brand" href="/dashboard">
      <svg width="30" height="30" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect x="25" y="5" width="50" height="90" rx="10" stroke="#00e676" stroke-width="5" fill="none"/>
        <rect x="35" y="15" width="30" height="55" rx="3" fill="#00e676" opacity="0.2"/>
        <circle cx="50" cy="80" r="5" fill="#00e676"/>
        <path d="M42 35 L50 28 L58 35" stroke="#00e676" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
        <line x1="50" y1="28" x2="50" y2="50" stroke="#00e676" stroke-width="3" stroke-linecap="round"/>
        <path d="M38 50 L50 42 L62 50" stroke="#00e676" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" opacity="0.5"/>
      </svg>
      Ferreira's Cell
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu"><span class="navbar-toggler-icon"></span></button>
    <div class="collapse navbar-collapse" id="navMenu">
      <ul class="navbar-nav me-auto">
        <li class="nav-item"><a class="nav-link<%= typeof pageTitle !== 'undefined' && pageTitle === 'Dashboard' ? ' active' : '' %>" href="/dashboard"><i class="bi bi-speedometer2"></i> Dashboard</a></li>
        <li class="nav-item"><a class="nav-link<%= typeof pageTitle !== 'undefined' && pageTitle === 'Ordens' ? ' active' : '' %>" href="/ordens"><i class="bi bi-tools"></i> Ordens</a></li>
        <li class="nav-item"><a class="nav-link<%= typeof pageTitle !== 'undefined' && pageTitle === 'Agenda' ? ' active' : '' %>" href="/agenda"><i class="bi bi-calendar3"></i> Agenda</a></li>
        <li class="nav-item"><a class="nav-link<%= typeof pageTitle !== 'undefined' && pageTitle === 'Clientes' ? ' active' : '' %>" href="/clientes"><i class="bi bi-people"></i> Clientes</a></li>
        <li class="nav-item"><a class="nav-link<%= typeof pageTitle !== 'undefined' && pageTitle === 'Estoque' ? ' active' : '' %>" href="/estoque"><i class="bi bi-box-seam"></i> Estoque</a></li>
        <li class="nav-item"><a class="nav-link<%= typeof pageTitle !== 'undefined' && pageTitle === 'Tabela de Precos' ? ' active' : '' %>" href="/precos"><i class="bi bi-tags"></i> Precos</a></li>
        <li class="nav-item"><a class="nav-link<%= typeof pageTitle !== 'undefined' && pageTitle === 'PDV' ? ' active' : '' %>" href="/pdv"><i class="bi bi-cart3"></i> PDV</a></li>
        <li class="nav-item"><a class="nav-link<%= typeof pageTitle !== 'undefined' && pageTitle === 'Vendas' ? ' active' : '' %>" href="/vendas"><i class="bi bi-receipt-cutoff"></i> Vendas</a></li>
        <li class="nav-item"><a class="nav-link<%= typeof pageTitle !== 'undefined' && pageTitle === 'Caixa' ? ' active' : '' %>" href="/caixa"><i class="bi bi-cash-stack"></i> Caixa</a></li>
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle<%= typeof pageTitle !== 'undefined' && pageTitle === 'Financeiro' ? ' active' : '' %>" href="#" data-bs-toggle="dropdown"><i class="bi bi-wallet2"></i> Financeiro</a>
          <ul class="dropdown-menu">
            <li><a class="dropdown-item" href="/financeiro"><i class="bi bi-graph-up"></i> Visão Geral</a></li>
            <li><a class="dropdown-item" href="/financeiro/contas"><i class="bi bi-receipt"></i> Contas</a></li>
            <li><a class="dropdown-item" href="/financeiro/compras"><i class="bi bi-bag"></i> Compras</a></li>
            <li><a class="dropdown-item" href="/financeiro/custos"><i class="bi bi-clipboard-data"></i> Custos Fixos</a></li>
            <li><a class="dropdown-item" href="/financeiro/relatorios"><i class="bi bi-file-earmark-bar-graph"></i> Relatórios</a></li>
          </ul>
        </li>
        <% if (user.papel === 'admin') { %>
        <li class="nav-item"><a class="nav-link<%= typeof pageTitle !== 'undefined' && pageTitle === 'Configurações' ? ' active' : '' %>" href="/configuracoes"><i class="bi bi-gear"></i> Config</a></li>
        <% } %>
      </ul>
      <ul class="navbar-nav align-items-center">
        <li class="nav-item">
          <button class="theme-toggle" onclick="toggleTheme()" title="Alternar tema" id="themeToggle">
            <i class="bi bi-moon-fill" id="themeIcon"></i>
          </button>
        </li>
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" data-bs-toggle="dropdown">
            <span class="user-avatar"><%= user.nome ? user.nome.charAt(0).toUpperCase() : 'U' %></span>
            <%= user.nome %>
          </a>
          <ul class="dropdown-menu dropdown-menu-end">
            <li><span class="dropdown-item text-muted" style="font-size:0.75rem; cursor:default;"><%= user.email %></span></li>
            <li><hr class="dropdown-divider" style="border-color: rgba(255,255,255,0.06);"></li>
            <li><a class="dropdown-item" href="/logout"><i class="bi bi-box-arrow-right"></i> Sair</a></li>
          </ul>
        </li>
      </ul>
    </div>
  </div>
</nav>
<% } %>
<div class="container-fluid mt-3">
