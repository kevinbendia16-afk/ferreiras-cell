<%- include('../partials/header', { pageTitle: 'Clientes' }) %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h4><i class="bi bi-people"></i> Clientes</h4>
  <a href="/clientes/novo" class="btn btn-success"><i class="bi bi-plus"></i> Novo Cliente</a>
</div>
<form class="mb-3">
  <div class="input-group">
    <input type="text" name="busca" class="form-control" placeholder="Buscar por nome, telefone ou CPF..." value="<%= busca %>">
    <button class="btn btn-outline-secondary"><i class="bi bi-search"></i></button>
  </div>
</form>
<div class="card">
  <div class="table-responsive">
    <table class="table table-hover mb-0">
      <thead><tr><th>#</th><th>Nome</th><th>Telefone</th><th>Email</th><th>CPF</th><th style="width:120px">Acoes</th></tr></thead>
      <tbody>
        <% clientes.forEach(c => { %>
        <tr>
          <td class="text-muted"><%= c.id %></td>
          <td><a href="/clientes/<%= c.id %>" class="fw-semibold"><%= c.nome %></a></td>
          <td>
            <% if (c.telefone) { %>
              <span><%= c.telefone %></span>
              <% const num = c.telefone.replace(/\D/g,''); %>
              <% const whatsNum = num.length <= 11 ? '55' + num : num; %>
              <a href="https://wa.me/<%= whatsNum %>" target="_blank" class="ms-2" title="WhatsApp" style="color:#25d366;font-size:1.1rem"><i class="bi bi-whatsapp"></i></a>
            <% } else { %>-<% } %>
          </td>
          <td><%= c.email || '-' %></td>
          <td><%= c.cpf || '-' %></td>
          <td>
            <div class="d-flex gap-1">
              <% if (c.telefone) { %>
              <% const n2 = c.telefone.replace(/\D/g,''); const w2 = n2.length <= 11 ? '55'+n2 : n2; %>
              <a href="https://wa.me/<%= w2 %>" target="_blank" class="btn btn-sm btn-outline-success" title="WhatsApp"><i class="bi bi-whatsapp"></i></a>
              <% } %>
              <a href="/clientes/<%= c.id %>/editar" class="btn btn-sm btn-outline-primary" title="Editar"><i class="bi bi-pencil"></i></a>
            </div>
          </td>
        </tr>
        <% }) %>
        <% if (!clientes.length) { %><tr><td colspan="6" class="text-center text-muted py-4"><i class="bi bi-inbox" style="font-size:2rem;display:block;margin-bottom:8px;opacity:0.3"></i>Nenhum cliente</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../partials/footer') %>
