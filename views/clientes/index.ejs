<%- include('../partials/header', { pageTitle: 'Clientes' }) %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h4><i class="bi bi-people"></i> Clientes</h4>
  <a href="/clientes/novo" class="btn btn-success"><i class="bi bi-plus"></i> Novo Cliente</a>
</div>
<form class="mb-3">
  <div class="input-group">
    <input type="text" name="busca" class="form-control" placeholder="Buscar por nome, telefone ou CPF..." value="<%= busca %>">
    <button class="btn btn-outline-secondary"><i class="bi bi-search"></i></button>
  </div>
</form>
<div class="table-responsive">
  <table class="table table-hover">
    <thead><tr><th>Nome</th><th>Telefone</th><th>Email</th><th>CPF</th><th>Ações</th></tr></thead>
    <tbody>
      <% clientes.forEach(c => { %>
      <tr>
        <td><a href="/clientes/<%= c.id %>"><%= c.nome %></a></td>
        <td><%= c.telefone || '-' %></td>
        <td><%= c.email || '-' %></td>
        <td><%= c.cpf || '-' %></td>
        <td><a href="/clientes/<%= c.id %>/editar" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a></td>
      </tr>
      <% }) %>
      <% if (!clientes.length) { %><tr><td colspan="5" class="text-center text-muted">Nenhum cliente</td></tr><% } %>
    </tbody>
  </table>
</div>
<%- include('../partials/footer') %>
