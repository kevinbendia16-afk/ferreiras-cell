<%- include('../partials/header', { pageTitle: cliente ? 'Editar Cliente' : 'Novo Cliente' }) %>
<h4><i class="bi bi-person-plus"></i> <%= cliente && cliente.id ? 'Editar' : 'Novo' %> Cliente</h4>
<% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
<form method="POST" action="/clientes<%= cliente && cliente.id ? '/'+cliente.id : '' %>">
  <div class="row g-3">
    <div class="col-md-6"><label class="form-label">Nome *</label><input type="text" name="nome" class="form-control" value="<%= cliente ? cliente.nome : '' %>" required></div>
    <div class="col-md-3"><label class="form-label">Telefone</label><input type="text" name="telefone" class="form-control" value="<%= cliente ? cliente.telefone||'' : '' %>"></div>
    <div class="col-md-3"><label class="form-label">CPF</label><input type="text" name="cpf" class="form-control" value="<%= cliente ? cliente.cpf||'' : '' %>"></div>
    <div class="col-md-6"><label class="form-label">Email</label><input type="email" name="email" class="form-control" value="<%= cliente ? cliente.email||'' : '' %>"></div>
    <div class="col-md-6"><label class="form-label">Endereço</label><input type="text" name="endereco" class="form-control" value="<%= cliente ? cliente.endereco||'' : '' %>"></div>
    <div class="col-12"><label class="form-label">Observações</label><textarea name="observacoes" class="form-control" rows="2"><%= cliente ? cliente.observacoes||'' : '' %></textarea></div>
  </div>
  <div class="mt-3">
    <button class="btn btn-success"><i class="bi bi-check"></i> Salvar</button>
    <a href="/clientes" class="btn btn-secondary">Cancelar</a>
  </div>
</form>
<%- include('../partials/footer') %>
