<%- include('../partials/header', { pageTitle: cliente.nome }) %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h4><i class="bi bi-person"></i> #<%= cliente.id %> - <%= cliente.nome %></h4>
  <div class="d-flex gap-2">
    <% if (cliente.telefone) { %>
    <% const num = cliente.telefone.replace(/\D/g,''); const whatsNum = num.length <= 11 ? '55'+num : num; %>
    <a href="https://wa.me/<%= whatsNum %>" target="_blank" class="btn btn-success btn-sm"><i class="bi bi-whatsapp"></i> WhatsApp</a>
    <% } %>
    <a href="/clientes/<%= cliente.id %>/editar" class="btn btn-outline-primary btn-sm"><i class="bi bi-pencil"></i> Editar</a>
  </div>
</div>

<div class="card mb-4">
  <div class="card-body">
    <div class="row g-3">
      <div class="col-md-3">
        <small class="text-muted d-block">Telefone</small>
        <% if (cliente.telefone) { %>
          <span><%= cliente.telefone %></span>
          <% const n2 = cliente.telefone.replace(/\D/g,''); const w2 = n2.length <= 11 ? '55'+n2 : n2; %>
          <a href="https://wa.me/<%= w2 %>" target="_blank" style="color:#25d366" class="ms-1"><i class="bi bi-whatsapp"></i></a>
        <% } else { %>-<% } %>
      </div>
      <div class="col-md-3"><small class="text-muted d-block">Email</small><%= cliente.email || '-' %></div>
      <div class="col-md-3"><small class="text-muted d-block">CPF</small><%= cliente.cpf || '-' %></div>
      <div class="col-md-3"><small class="text-muted d-block">Endereco</small><%= cliente.endereco || '-' %></div>
      <% if (cliente.observacoes) { %>
      <div class="col-12"><small class="text-muted d-block">Observacoes</small><%= cliente.observacoes %></div>
      <% } %>
      <div class="col-12"><small class="text-muted">Cliente desde <%= new Date(cliente.criado_em).toLocaleDateString('pt-BR') %></small></div>
    </div>
  </div>
</div>

<h5 class="mb-3"><i class="bi bi-tools"></i> Ordens de Servico (<%= ordens.length %>)</h5>
<div class="card mb-4">
  <div class="table-responsive">
    <table class="table table-hover mb-0">
      <thead><tr><th>Numero</th><th>Aparelho</th><th>Status</th><th>Valor</th><th>Data</th></tr></thead>
      <tbody>
        <% ordens.forEach(os => { %>
        <tr onclick="location.href='/ordens/<%= os.id %>'" style="cursor:pointer">
          <td class="text-success fw-bold"><%= os.numero %></td>
          <td><%= os.aparelho_marca %> <%= os.aparelho_modelo %></td>
          <td><span class="badge bg-<%= os.status==='entregue'?'success':os.status==='cancelada'?'danger':os.status==='pronto'?'info':'warning' %>"><%= os.status %></span></td>
          <td class="fw-semibold">R$ <%= Number(os.valor_total||0).toFixed(2) %></td>
          <td class="text-muted"><%= new Date(os.criado_em).toLocaleDateString('pt-BR') %></td>
        </tr>
        <% }) %>
        <% if (!ordens.length) { %><tr><td colspan="5" class="text-muted text-center py-3">Nenhuma OS</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>

<h5 class="mb-3"><i class="bi bi-cart3"></i> Compras (<%= vendas.length %>)</h5>
<div class="card">
  <div class="table-responsive">
    <table class="table table-hover mb-0">
      <thead><tr><th>ID</th><th>Valor</th><th>Pagamento</th><th>Data</th></tr></thead>
      <tbody>
        <% vendas.forEach(v => { %>
        <tr>
          <td>#<%= v.id %></td>
          <td class="fw-semibold">R$ <%= Number(v.valor_total).toFixed(2) %></td>
          <td><%= v.forma_pagamento || '-' %></td>
          <td class="text-muted"><%= new Date(v.criado_em).toLocaleDateString('pt-BR') %></td>
        </tr>
        <% }) %>
        <% if (!vendas.length) { %><tr><td colspan="4" class="text-muted text-center py-3">Nenhuma compra</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../partials/footer') %>
