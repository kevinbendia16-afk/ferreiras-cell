<%- include('../partials/header', { pageTitle: os ? 'Editar OS' : 'Nova OS' }) %>
<h4><i class="bi bi-tools"></i> <%= os && os.id ? 'Editar OS #'+os.numero : 'Nova Ordem de Servico' %></h4>
<% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
<form method="POST" action="/ordens<%= os && os.id ? '/'+os.id : '' %>">
  <div class="row g-3">
    <div class="col-md-4">
      <label class="form-label">Cliente *</label>
      <select name="cliente_id" class="form-select" required>
        <option value="">Selecione...</option>
        <% clientes.forEach(c => { %>
        <option value="<%= c.id %>" <%= os && String(os.cliente_id)===String(c.id)?'selected':'' %>><%= c.nome %></option>
        <% }) %>
      </select>
    </div>
    <div class="col-md-4">
      <label class="form-label">Tecnico</label>
      <select name="tecnico_id" class="form-select">
        <option value="">Nenhum</option>
        <% tecnicos.forEach(t => { %>
        <option value="<%= t.id %>" <%= os && String(os.tecnico_id)===String(t.id)?'selected':'' %>><%= t.nome %></option>
        <% }) %>
      </select>
    </div>
    <div class="col-md-4">
      <label class="form-label">Previsao de Entrega</label>
      <input type="date" name="data_previsao" class="form-control" value="<%= os && os.data_previsao ? new Date(os.data_previsao).toISOString().slice(0,10) : '' %>">
    </div>
    <div class="col-md-3"><label class="form-label">Marca *</label><input type="text" name="aparelho_marca" class="form-control" value="<%= os ? os.aparelho_marca||'' : '' %>" required placeholder="Ex: Samsung, Apple"></div>
    <div class="col-md-3"><label class="form-label">Modelo *</label><input type="text" name="aparelho_modelo" class="form-control" value="<%= os ? os.aparelho_modelo||'' : '' %>" required placeholder="Ex: Galaxy A52"></div>
    <div class="col-md-3"><label class="form-label">IMEI</label><input type="text" name="imei" class="form-control" value="<%= os ? os.imei||'' : '' %>"></div>
    <% if (os && os.id) { %>
    <div class="col-md-3">
      <label class="form-label">Status</label>
      <select name="status" class="form-select">
        <% ['aberta','aguardando_peca','em_reparo','pronto','entregue','cancelada'].forEach(s => { %>
        <option value="<%= s %>" <%= os.status===s?'selected':'' %>><%= s %></option>
        <% }) %>
      </select>
    </div>
    <% } %>
    <div class="col-12"><label class="form-label">Defeito Relatado *</label><textarea name="defeito_relatado" class="form-control" rows="2" required><%= os ? os.defeito_relatado||'' : '' %></textarea></div>
    <% if (os && os.id) { %>
    <div class="col-md-6"><label class="form-label">Diagnostico</label><textarea name="diagnostico" class="form-control" rows="2"><%= os ? os.diagnostico||'' : '' %></textarea></div>
    <div class="col-md-6"><label class="form-label">Solucao</label><textarea name="solucao" class="form-control" rows="2"><%= os ? os.solucao||'' : '' %></textarea></div>
    <% } %>
    <div class="col-md-3"><label class="form-label">Mao de Obra (R$)</label><input type="number" name="valor_servico" class="form-control" step="0.01" min="0" value="<%= os ? os.valor_servico||0 : 0 %>"></div>
    <div class="col-md-3"><label class="form-label">Sinal (R$)</label><input type="number" name="valor_sinal" class="form-control" step="0.01" min="0" value="<%= os ? os.valor_sinal||0 : 0 %>" placeholder="Entrada do cliente"></div>
    <% if (os && os.id) { %>
    <div class="col-md-3">
      <label class="form-label">Forma Pagamento</label>
      <select name="forma_pagamento" class="form-select">
        <option value="">-</option>
        <% ['Dinheiro','Pix','Cartao Debito','Cartao Credito'].forEach(f => { %>
        <option value="<%= f %>" <%= os && os.forma_pagamento===f?'selected':'' %>><%= f %></option>
        <% }) %>
      </select>
    </div>
    <% } %>
    <div class="col-12"><label class="form-label">Observacoes</label><textarea name="observacoes" class="form-control" rows="2"><%= os ? os.observacoes||'' : '' %></textarea></div>
  </div>
  <div class="mt-3">
    <button class="btn btn-success"><i class="bi bi-check"></i> Salvar</button>
    <a href="/ordens" class="btn btn-secondary">Cancelar</a>
  </div>
</form>
<%- include('../partials/footer') %>
