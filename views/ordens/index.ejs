<%- include('../partials/header', { pageTitle: 'Ordens de Serviço' }) %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h4><i class="bi bi-tools"></i> Ordens de Serviço</h4>
  <a href="/ordens/nova" class="btn btn-success"><i class="bi bi-plus"></i> Nova OS</a>
</div>
<form class="row g-2 mb-3">
  <div class="col-md-4">
    <input type="text" name="busca" class="form-control" placeholder="Buscar por cliente, número ou modelo..." value="<%= busca %>">
  </div>
  <div class="col-md-3">
    <select name="status" class="form-select">
      <option value="">Todos os status</option>
      <% ['aberta','aguardando_peca','em_reparo','pronto','entregue','cancelada'].forEach(s => { %>
      <option value="<%= s %>" <%= status===s?'selected':'' %>><%= s %></option>
      <% }) %>
    </select>
  </div>
  <div class="col-auto"><button class="btn btn-outline-secondary"><i class="bi bi-search"></i> Filtrar</button></div>
</form>
<div class="table-responsive">
  <table class="table table-hover">
    <thead><tr><th>Número</th><th>Cliente</th><th>Aparelho</th><th>Técnico</th><th>Status</th><th>Valor</th><th>Entrada</th></tr></thead>
    <tbody>
      <% ordens.forEach(os => { %>
      <tr onclick="location.href='/ordens/<%= os.id %>'" style="cursor:pointer">
        <td><%= os.numero %></td>
        <td><%= os.cliente_nome || '-' %></td>
        <td><%= os.aparelho_marca %> <%= os.aparelho_modelo %></td>
        <td><%= os.tecnico_nome || '-' %></td>
        <td><span class="badge bg-<%= os.status==='entregue'?'success':os.status==='cancelada'?'danger':os.status==='pronto'?'info':os.status==='em_reparo'?'primary':os.status==='aguardando_peca'?'secondary':'warning' %>"><%= os.status %></span></td>
        <td>R$ <%= Number(os.valor_total||0).toFixed(2) %></td>
        <td><%= new Date(os.data_entrada).toLocaleDateString('pt-BR') %></td>
      </tr>
      <% }) %>
      <% if (!ordens.length) { %><tr><td colspan="7" class="text-center text-muted">Nenhuma OS encontrada</td></tr><% } %>
    </tbody>
  </table>
</div>
<%- include('../partials/footer') %>
