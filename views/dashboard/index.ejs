<%- include('../partials/header', { pageTitle: 'Dashboard' }) %>

<%
  const hour = new Date().getHours();
  const greeting = hour < 12 ? 'Bom dia' : hour < 18 ? 'Boa tarde' : 'Boa noite';
%>

<div class="greeting"><%= greeting %>, <strong><%= user.nome %></strong> 👋</div>
<div class="greeting-sub"><%= new Date().toLocaleDateString('pt-BR', {weekday:'long', day:'numeric', month:'long', year:'numeric'}) %></div>

<div class="quick-actions">
  <a href="/ordens/nova" class="quick-action-btn"><i class="bi bi-plus-circle"></i> Nova OS</a>
  <a href="/pdv" class="quick-action-btn"><i class="bi bi-cart3"></i> Vender</a>
  <a href="/clientes/novo" class="quick-action-btn"><i class="bi bi-person-plus"></i> Novo Cliente</a>
  <a href="/financeiro" class="quick-action-btn"><i class="bi bi-graph-up"></i> Financeiro</a>
</div>

<div class="row g-3 mb-4">
  <div class="col-md col-6">
    <div class="stat-card blue animate-in">
      <i class="bi bi-tools stat-icon"></i>
      <div class="stat-value"><%= stats.osAbertas || 0 %></div>
      <div class="stat-label">OS Abertas</div>
    </div>
  </div>
  <div class="col-md col-6">
    <div class="stat-card purple animate-in animate-in-delay-1">
      <i class="bi bi-calendar-check stat-icon"></i>
      <div class="stat-value"><%= stats.osHoje || 0 %></div>
      <div class="stat-label">OS Hoje</div>
    </div>
  </div>
  <div class="col-md col-6">
    <div class="stat-card green animate-in animate-in-delay-2">
      <i class="bi bi-currency-dollar stat-icon"></i>
      <div class="stat-value">R$ <%= Number(stats.faturamentoHoje || 0).toFixed(2) %></div>
      <div class="stat-label">Faturamento Hoje</div>
    </div>
  </div>
  <div class="col-md col-6">
    <div class="stat-card orange animate-in animate-in-delay-3">
      <i class="bi bi-exclamation-triangle stat-icon"></i>
      <div class="stat-value"><%= stats.estoqueBaixo || 0 %></div>
      <div class="stat-label">Estoque Baixo</div>
    </div>
  </div>
  <div class="col-md col-6">
    <div class="stat-card cyan animate-in animate-in-delay-4">
      <i class="bi bi-people stat-icon"></i>
      <div class="stat-value"><%= stats.totalClientes || 0 %></div>
      <div class="stat-label">Clientes</div>
    </div>
  </div>
</div>

<div class="row g-3 mb-4">
  <div class="col-md-4 col-6">
    <div class="stat-card green animate-in animate-in-delay-2">
      <i class="bi bi-graph-up-arrow stat-icon"></i>
      <div class="stat-value">R$ <%= Number(stats.faturamentoMes || 0).toFixed(2) %></div>
      <div class="stat-label">Faturamento do Mês</div>
    </div>
  </div>
  <div class="col-md-4 col-6">
    <div class="stat-card purple animate-in animate-in-delay-3">
      <i class="bi bi-check2-circle stat-icon"></i>
      <div class="stat-value"><%= stats.osEntregues || 0 %></div>
      <div class="stat-label">OS Entregues (Mês)</div>
    </div>
  </div>
  <div class="col-md-4 col-6">
    <div class="stat-card blue animate-in animate-in-delay-4">
      <i class="bi bi-bullseye stat-icon"></i>
      <div class="stat-value">R$ <%= Number(stats.ticketMedio || 0).toFixed(2) %></div>
      <div class="stat-label">Ticket Médio</div>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center">
    <span><i class="bi bi-clock-history text-success me-2"></i>Últimas Ordens de Serviço</span>
    <a href="/ordens/nova" class="btn btn-sm btn-success"><i class="bi bi-plus me-1"></i>Nova OS</a>
  </div>
  <div class="table-responsive">
    <table class="table table-hover mb-0">
      <thead><tr><th>Número</th><th>Cliente</th><th>Aparelho</th><th>Status</th><th>Valor</th><th>Data</th></tr></thead>
      <tbody>
        <% ultimasOS.forEach(os => { %>
        <tr onclick="location.href='/ordens/<%= os.id %>'">
          <td><span class="text-success fw-bold"><%= os.numero %></span></td>
          <td><%= os.cliente_nome || '-' %></td>
          <td><%= os.aparelho_marca %> <%= os.aparelho_modelo %></td>
          <td><span class="badge bg-<%= os.status==='entregue'?'success':os.status==='cancelada'?'danger':os.status==='pronto'?'info':'warning' %>"><%= os.status %></span></td>
          <td class="fw-semibold">R$ <%= Number(os.valor_total||0).toFixed(2) %></td>
          <td class="text-muted"><%= new Date(os.criado_em).toLocaleDateString('pt-BR') %></td>
        </tr>
        <% }) %>
        <% if (!ultimasOS.length) { %>
        <tr><td colspan="6">
          <div class="empty-state">
            <i class="bi bi-inbox"></i>
            <div>Nenhuma OS registrada ainda</div>
          </div>
        </td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../partials/footer') %>
