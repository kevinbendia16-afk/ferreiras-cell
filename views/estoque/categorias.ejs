<%- include('../partials/header', { pageTitle: 'Categorias' }) %>
<h4><i class="bi bi-tags"></i> Categorias de Produto</h4>
<div class="row">
  <div class="col-md-8">
    <table class="table">
      <thead><tr><th>Nome</th><th>Tipo</th></tr></thead>
      <tbody>
        <% categorias.forEach(c => { %>
        <tr><td><%= c.nome %></td><td><span class="badge bg-<%= c.tipo==='peca'?'primary':'success' %>"><%= c.tipo %></span></td></tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <div class="col-md-4">
    <div class="card">
      <div class="card-header">Nova Categoria</div>
      <div class="card-body">
        <form method="POST" action="/estoque/categorias">
          <div class="mb-2"><input type="text" name="nome" class="form-control" placeholder="Nome" required></div>
          <div class="mb-2">
            <select name="tipo" class="form-select"><option value="peca">Peça</option><option value="acessorio">Acessório</option></select>
          </div>
          <button class="btn btn-success btn-sm w-100">Adicionar</button>
        </form>
      </div>
    </div>
  </div>
</div>
<a href="/estoque" class="btn btn-secondary mt-2">Voltar</a>
<%- include('../partials/footer') %>
