<%- include('../partials/header', { pageTitle: produto ? 'Editar Produto' : 'Novo Produto' }) %>
<h4><i class="bi bi-box-seam"></i> <%= produto && produto.id ? 'Editar' : 'Novo' %> Produto</h4>
<% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
<form method="POST" action="/estoque<%= produto && produto.id ? '/'+produto.id : '' %>">
  <div class="row g-3">
    <div class="col-md-6"><label class="form-label">Nome *</label><input type="text" name="nome" class="form-control" value="<%= produto ? produto.nome : '' %>" required></div>
    <div class="col-md-3">
      <label class="form-label">Categoria *</label>
      <select name="categoria_id" class="form-select" required>
        <% categorias.forEach(c => { %>
        <option value="<%= c.id %>" <%= produto && String(produto.categoria_id)===String(c.id)?'selected':'' %>><%= c.nome %></option>
        <% }) %>
      </select>
    </div>
    <div class="col-md-3"><label class="form-label">Código de Barras</label><input type="text" name="codigo_barras" class="form-control" value="<%= produto ? produto.codigo_barras||'' : '' %>"></div>
    <div class="col-md-3"><label class="form-label">Preço Custo</label><input type="number" name="preco_custo" class="form-control" step="0.01" value="<%= produto ? produto.preco_custo : 0 %>"></div>
    <div class="col-md-3"><label class="form-label">Preço Venda</label><input type="number" name="preco_venda" class="form-control" step="0.01" value="<%= produto ? produto.preco_venda : 0 %>"></div>
    <div class="col-md-3"><label class="form-label">Estoque Atual</label><input type="number" name="estoque_atual" class="form-control" value="<%= produto ? produto.estoque_atual : 0 %>"></div>
    <div class="col-md-3"><label class="form-label">Estoque Mínimo</label><input type="number" name="estoque_minimo" class="form-control" value="<%= produto ? produto.estoque_minimo : 1 %>"></div>
  </div>
  <div class="mt-3">
    <button class="btn btn-success"><i class="bi bi-check"></i> Salvar</button>
    <a href="/estoque" class="btn btn-secondary">Cancelar</a>
  </div>
</form>
<%- include('../partials/footer') %>
