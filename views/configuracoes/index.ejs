<%- include('../partials/header', { pageTitle: 'Configurações' }) %>
<h4><i class="bi bi-gear"></i> Configurações</h4>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h5>Usuários</h5>
  <a href="/configuracoes/usuarios/novo" class="btn btn-success btn-sm"><i class="bi bi-plus"></i> Novo Usuário</a>
</div>
<div class="table-responsive">
  <table class="table">
    <thead><tr><th>Nome</th><th>Email</th><th>Papel</th><th>Ativo</th><th>Ações</th></tr></thead>
    <tbody>
      <% usuarios.forEach(u => { %>
      <tr>
        <td><%= u.nome %></td>
        <td><%= u.email %></td>
        <td><span class="badge bg-<%= u.papel==='admin'?'danger':'primary' %>"><%= u.papel %></span></td>
        <td><%= u.ativo ? 'Sim' : 'Não' %></td>
        <td><a href="/configuracoes/usuarios/<%= u.id %>/editar" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a></td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<%- include('../partials/footer') %>
